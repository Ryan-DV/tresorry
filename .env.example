# Copy to .env and adjust. .env is gitignored.

# Folder on the host that Tresorry serves and uploads into
SHARE_DIR=./data

# Host port (HTTPS)
TRESORRY_PORT=443

# Hostnames/IPs the self-signed cert should be valid for, comma separated.
# Add the LAN IP clients will use. Delete ./certs and restart to regenerate.
CERT_SANS=localhost,127.0.0.1

# Linux hosts: run the container as your own user so it can write ./secrets, ./certs
# and SHARE_DIR. Set these to the output of `id -u` and `id -g`. (Not needed on Docker Desktop.)
# TRESORRY_UID=1000
# TRESORRY_GID=1000
